# macOS
.DS_Store
**/.DS_Store

# KiCad · archivos de bloqueo y respaldos que genera al abrir un proyecto.
# No son parte del diseño y cambian en cada sesión de edición.
*.lck
*.kicad_prl
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache

# LaTeX: archivos auxiliares de compilación
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*-blx.bib

# KiCad · export 3D de la placa (Archivo → Exportar → GLB, ~5,6 MB). Se
# regenera desde KiCad; la app usa la versión optimizada que genera
# UI_REACT/scripts/optimizar-pcb.mjs (UI_REACT/src/assets/chidori-pcb.glb).
PCB PFC/*.glb
