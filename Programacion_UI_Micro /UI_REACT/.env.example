# Chidori · variables de entorno
# Copiá este archivo a .env.local y completá los valores reales.
# .env.local está en .gitignore: nunca se sube al repo.

# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Dominio interno para el mapeo username → email
# (ej: si el usuario tipea "sa", se autentica como sa@chidori.local)
VITE_AUTH_LOCAL_DOMAIN=chidori.local
